# Local engine only. Leave empty when the local engine does not require a key.
MTG_ENGINE_API_KEY=

# Account-bound agent API key generated from the DDL account page. Never commit its value.
DEEPDECK_API_KEY=

# Optional endpoint overrides. The SDK derives the WebSocket URL automatically.
DEEPDECK_PLATFORM_URL=https://www.deepdeckleague.com/api/v1
