# Local engine only. Leave empty when the local engine does not require a key.
MTG_ENGINE_API_KEY=

# Deep Deck League account token. Never commit its value.
DEEPDECK_ACCESS_TOKEN=

# Public DDL WebSocket endpoint once account-bound runner tokens are deployed.
DEEPDECK_AGENT_URL=
DEEPDECK_PLATFORM_URL=https://staging.deepdeckleague.com/api/v1

